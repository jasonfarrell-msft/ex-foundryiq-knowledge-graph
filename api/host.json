{
  "version": "2.0",
  "functionTimeout": "00:00:40",
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxConcurrentRequests": 4,
      "maxOutstandingRequests": 8
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Host.Results": "Information"
    }
  }
}
